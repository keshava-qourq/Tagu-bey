# Elastic Beanstalk's Node.js platform installs with NODE_ENV=production,
# which skips devDependencies - but this app needs "typescript" (a
# devDependency) to compile before it can run. Force a full install +
# build during the deploy hook (runs once per deploy, before the app
# starts), then apply any pending Prisma migrations against RDS.
container_commands:
  01_full_install:
    command: "npm install --include=dev"
  02_build:
    command: "npm run build"
  03_prisma_generate:
    command: "npx prisma generate"
  04_migrate:
    command: "npx prisma migrate deploy"
    leader_only: true
