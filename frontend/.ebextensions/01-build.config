# Elastic Beanstalk's Node.js platform installs with NODE_ENV=production,
# which skips devDependencies - but this app needs "typescript" and
# "@tailwindcss/postcss" (both devDependencies) to build. Force a full
# install + build during the deploy hook, before the app starts.
container_commands:
  01_full_install:
    command: "npm install --include=dev"
  02_build:
    command: "npm run build"
